<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title><%= @page[:title] %></title>
    <meta name="description" content="<%= @page[:description] %>">
    <link rel="canonical" href="<%= canonical_url %>">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Inertia">
    <meta property="og:title" content="<%= @page[:title] %>">
    <meta property="og:description" content="<%= @page[:description] %>">
    <meta property="og:url" content="<%= canonical_url %>">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= @page[:title] %>">
    <meta name="twitter:description" content="<%= @page[:description] %>">

    <script type="application/ld+json">
<%= raw({
  "@context" => "https://schema.org",
  "@type" => "SoftwareApplication",
  "name" => "Inertia",
  "applicationCategory" => "ProductivityApplication",
  "operatingSystem" => "Web, macOS, iOS",
  "url" => request.base_url
}.to_json) %>
    </script>

    <script>
      // Applies the stored theme before first paint (no light flash); this has to
      // be inline. The toggle itself is in marketing.js.
      (function () {
        var stored = null
        try { stored = localStorage.getItem('inertia-marketing-theme') } catch (e) {}
        if (stored === 'light' || stored === 'dark') document.documentElement.setAttribute('data-theme', stored)
      })()
    </script>
    <link rel="stylesheet" href="<%= marketing_asset_path('marketing.css') %>">
    <% if @page[:redirect_authenticated_to] %>
    <meta name="inertia-redirect" content="<%= app_url(@page[:redirect_authenticated_to]) %>">
    <% end %>
    <script src="<%= marketing_asset_path('marketing.js') %>"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Inertia</a>
        <nav>
          <a class="nav_secondary" href="/features">Features</a>
          <a class="nav_secondary" href="/pricing">Pricing</a>
          <a class="signed_out_only" href="<%= app_url("/login") %>">Sign in</a>
          <a class="btn signed_out_only" href="<%= app_url("/signup") %>">Sign up</a>
          <a class="btn signed_in_only" href="<%= app_url("/space") %>">Open app</a>
          <button type="button" class="theme_toggle" aria-label="Dark mode" title="Toggle dark mode" aria-pressed="false" hidden>
            <svg class="theme_toggle-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="theme_toggle-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-row">
        <span>&copy; <%= Time.current.year %> Inertia</span>
        <nav>
          <a href="/features">Features</a>
          <a href="/pricing">Pricing</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
