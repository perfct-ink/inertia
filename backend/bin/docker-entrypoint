#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ] && [ -f /usr/lib/*/libjemalloc.so.2 ]; then
  export LD_PRELOAD="$(echo /usr/lib/*/libjemalloc.so.2)"
fi

# Coolify passes every variable in the resource to the container, so a
# DATABASE_URL added but left empty arrives as "". Rails refuses to boot
# with an empty DATABASE_URL; unset means "stay on MySQL" instead.
[ -z "${DATABASE_URL}" ] && unset DATABASE_URL

# If running the rails server then create or migrate existing database
if [ "${1}" == "./bin/rails" ] && [ "${2}" == "server" ]; then
  # One-time copy of the old MySQL data once production is on PostgreSQL; a
  # no-op before that and after it has run. It goes before db:prepare so
  # seeds never land in the empty database first, and a failed copy stops the
  # boot rather than serving an empty database.
  ./bin/rails db:import_mysql
  ./bin/rails db:prepare
fi

exec "${@}"
